# Copy to .env (which is git-ignored) and fill in. There are no default tokens: the stack will not start without them.
#
# Generate two different long random values, e.g. in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# or in a shell:
#   openssl rand -base64 24

AEGIS_ADMIN_TOKEN=
AEGIS_VIEWER_TOKEN=

# Host port for the dashboard (bound to 127.0.0.1).
AEGIS_PORT=8080
